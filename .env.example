# ==========================================================
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES (NO VITE_ PREFIX!)
# Used by Vercel Serverless Functions (/api/*) & Express
# ==========================================================
# Bcrypt hash of your admin password (default accepts '123' if not set)
ADMIN_PASSWORD_HASH="$2a$10$YourGeneratedBcryptHashHere"

# Cryptographic secret for signing httpOnly session cookies
ADMIN_SESSION_SECRET="your-secure-random-session-secret-at-least-32-chars"

# Supabase Server-side (Service Role Key for full RLS bypass on writes)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (VITE_ PREFIX)
# Used by Vite & React browser bundle
# ==========================================================
# Supabase Configuration (Required for live data fetching & realtime)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# GEMINI_API_KEY: Optional
GEMINI_API_KEY=""

# APP_URL: Optional
APP_URL=""
