# ==========================================================
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES (NO VITE_ PREFIX!)
# Used by Vercel Serverless Functions (/api/*) & Express
# ==========================================================
# Bcrypt hash of your admin password (e.g. generated via bcryptjs with 10 rounds)
# Example hash for 'YourPassword123'
ADMIN_PASSWORD_HASH="$2a$10$YourGeneratedBcryptHashHere"

# Cryptographic secret for signing httpOnly session cookies
ADMIN_SESSION_SECRET="your-secure-random-session-secret-at-least-32-chars"

# ==========================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (VITE_ PREFIX)
# ==========================================================
# Supabase Configuration (Required for cross-device avatar synchronization)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# GEMINI_API_KEY: Optional
GEMINI_API_KEY=""

# APP_URL: Optional
APP_URL=""
